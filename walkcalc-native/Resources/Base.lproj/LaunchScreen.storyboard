                            <constraint firstItem="title-image" firstAttribute="height" id="launch-c-37" secondItem="scale-reference" secondAttribute="width" multiplier="0.07948717948717948" />
                            <constraint firstItem="status-slot" firstAttribute="top" id="launch-c-38" secondItem="title-image" secondAttribute="bottom" />
                            <constraint firstItem="status-slot" firstAttribute="leading" id="launch-c-39" secondItem="brand-group" secondAttribute="leading" />
                            <constraint firstItem="status-slot" firstAttribute="height" id="launch-c-40" constant="24" />
                            <constraint firstItem="status-slot" firstAttribute="width" id="launch-c-41" secondItem="scale-reference" secondAttribute="width" multiplier="0.6666666666666666" priority="750" />
                            <constraint firstItem="status-slot" firstAttribute="width" id="launch-c-42" secondItem="brand-group" secondAttribute="width" relation="lessThanOrEqual" />
                            <constraint firstItem="status-slot" firstAttribute="bottom" id="launch-c-43" secondItem="brand-group" secondAttribute="bottom" />
                        </constraints>

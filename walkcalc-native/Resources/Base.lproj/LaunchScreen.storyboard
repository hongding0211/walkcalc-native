                                        <rect key="frame" x="0" y="75.731707" width="310" height="31" />
                                    </imageView>
                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="status-slot" tag="701">
                                        <rect key="frame" x="0" y="106.731707" width="260" height="24" />
                                    </view>
                                </subviews>
                            </view>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="launch-safe-area" />
                        <color key="backgroundColor" name="LaunchBackground" />
                        <!-- The scale reference reproduces clamp(min(width/390, height/844), 0.82, 1).
                             Asset intrinsic sizes must not override it. The centered 318-point column
                             shares its leading edge and scale with the login buttons.
                             Status slot 701 stays empty during launch and is filled only by StartupScreen.
                             Tags 702, 703 and 704 identify the scale, title and visible logo bounds. -->
                        <constraints>
                            <constraint firstItem="scale-reference" firstAttribute="leading" id="launch-c-1" secondItem="launch-root" secondAttribute="leading" />
                            <constraint firstItem="scale-reference" firstAttribute="top" id="launch-c-2" secondItem="launch-root" secondAttribute="top" />
                            <constraint firstItem="scale-reference" firstAttribute="height" id="launch-c-3" constant="0" />
                            <constraint firstItem="scale-reference" firstAttribute="width" id="launch-c-4" constant="319.8" relation="greaterThanOrEqual" />
                            <constraint firstItem="scale-reference" firstAttribute="width" id="launch-c-5" constant="390" relation="lessThanOrEqual" />
                            <constraint firstItem="scale-reference" firstAttribute="width" id="launch-c-6" secondItem="launch-root" secondAttribute="width" relation="lessThanOrEqual" priority="999" />
                            <constraint firstItem="scale-reference" firstAttribute="width" id="launch-c-7" secondItem="launch-root" secondAttribute="height" multiplier="0.46208530805687204" relation="lessThanOrEqual" priority="999" />
                            <constraint firstItem="scale-reference" firstAttribute="width" id="launch-c-8" constant="390" priority="250" />
                            <constraint firstItem="brand-group" firstAttribute="centerY" id="launch-c-9" secondItem="launch-root" secondAttribute="centerY" />
                            <constraint firstItem="brand-group" firstAttribute="leading" id="launch-c-10" secondItem="launch-root" secondAttribute="leading" constant="24" relation="greaterThanOrEqual" />
                            <constraint firstItem="brand-group" firstAttribute="trailing" id="launch-c-11" secondItem="launch-root" secondAttribute="trailing" constant="-24" relation="lessThanOrEqual" />
                            <constraint firstItem="brand-group" firstAttribute="width" id="launch-c-12" secondItem="scale-reference" secondAttribute="width" multiplier="0.8153846153846154" priority="750" />
                            <constraint firstItem="brand-group" firstAttribute="centerX" id="launch-c-13" secondItem="launch-root" secondAttribute="centerX" />
                            <constraint firstItem="logo-bounds" firstAttribute="leading" id="launch-c-14" secondItem="brand-group" secondAttribute="leading" />
                            <constraint firstItem="logo-bounds" firstAttribute="top" id="launch-c-15" secondItem="brand-group" secondAttribute="top" />
                            <constraint firstItem="logo-bounds" firstAttribute="width" id="launch-c-16" secondItem="scale-reference" secondAttribute="width" multiplier="0.1076923076923077" />
                            <constraint firstItem="logo-bounds" firstAttribute="height" id="launch-c-17" secondItem="logo-bounds" secondAttribute="width" multiplier="1.2317073170731707" />
                            <constraint firstItem="logo-image" firstAttribute="width" id="launch-c-18" secondItem="scale-reference" secondAttribute="width" multiplier="0.19699812382739212" />
                            <constraint firstItem="logo-image" firstAttribute="height" id="launch-c-19" secondItem="logo-image" secondAttribute="width" />
                            <constraint firstItem="logo-left-padding" firstAttribute="leading" id="launch-c-20" secondItem="logo-image" secondAttribute="leading" />
                            <constraint firstItem="logo-left-padding" firstAttribute="width" id="launch-c-21" secondItem="logo-image" secondAttribute="width" multiplier="0.23333333333333334" />
                            <constraint firstItem="logo-left-padding" firstAttribute="trailing" id="launch-c-22" secondItem="logo-bounds" secondAttribute="leading" />
                            <constraint firstItem="logo-left-padding" firstAttribute="height" id="launch-c-23" constant="0" />
                            <constraint firstItem="logo-left-padding" firstAttribute="top" id="launch-c-24" secondItem="brand-group" secondAttribute="top" />
                            <constraint firstItem="logo-top-padding" firstAttribute="top" id="launch-c-25" secondItem="logo-image" secondAttribute="top" />
                            <constraint firstItem="logo-top-padding" firstAttribute="height" id="launch-c-26" secondItem="logo-image" secondAttribute="height" multiplier="0.16666666666666666" />
                            <constraint firstItem="logo-top-padding" firstAttribute="bottom" id="launch-c-27" secondItem="logo-bounds" secondAttribute="top" />
                            <constraint firstItem="logo-top-padding" firstAttribute="width" id="launch-c-28" constant="0" />
                            <constraint firstItem="logo-top-padding" firstAttribute="leading" id="launch-c-29" secondItem="brand-group" secondAttribute="leading" />
                            <constraint firstItem="logo-title-gap" firstAttribute="top" id="launch-c-30" secondItem="logo-bounds" secondAttribute="bottom" />
                            <constraint firstItem="logo-title-gap" firstAttribute="height" id="launch-c-31" secondItem="scale-reference" secondAttribute="width" multiplier="0.06153846153846154" />
                            <constraint firstItem="logo-title-gap" firstAttribute="width" id="launch-c-32" constant="0" />
                            <constraint firstItem="logo-title-gap" firstAttribute="leading" id="launch-c-33" secondItem="brand-group" secondAttribute="leading" />

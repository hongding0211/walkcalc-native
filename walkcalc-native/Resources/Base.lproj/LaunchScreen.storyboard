                                        <rect key="frame" x="0" y="0" width="42" height="51.731707" />
                                    </view>
                                    <imageView contentMode="scaleAspectFit" translatesAutoresizingMaskIntoConstraints="NO" id="logo-image" image="StartupLogo" userInteractionEnabled="NO" horizontalCompressionResistancePriority="1" verticalCompressionResistancePriority="1" horizontalHuggingPriority="1" verticalHuggingPriority="1">
                                        <rect key="frame" x="-17.926829" y="-12.804878" width="76.829268" height="76.829268" />
                                    </imageView>
                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="logo-left-padding" hidden="YES">
                                        <rect key="frame" x="-17.926829" y="0" width="17.926829" height="0" />
                                    </view>
                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="logo-top-padding" hidden="YES">
